# Browser-safe Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback; remove after updating all deployment environments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Stripe credentials and webhook signing secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Country used when creating connected contractor accounts (ISO 3166-1 alpha-2).
STRIPE_CONNECT_ACCOUNT_COUNTRY=US

# Server-only Google Gemini API key and model selection.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server-only Resend API key and verified sender identity.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Server-only scheduled-task bearer secret.
CRON_SECRET=
# Browser-safe canonical URLs and public support contact.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
